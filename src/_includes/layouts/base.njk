<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or village.siteTitle }}</title>
  <meta name="description" content="{{ description or village.siteDescription }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <script>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    })();
  </script>
</head>
<body>
  <div class="ai-disclosure-banner">
    <div class="ai-disclosure-content">
      <span>⚡ This site is aggregated using automation, including generative AI for summaries</span>
    </div>
    <div class="theme-toggle-group" role="radiogroup" aria-label="Theme selection">
      <button type="button" class="theme-btn" data-theme-val="auto" aria-label="Auto system theme" title="Auto (Browser Default)">
        <span class="theme-icon">Ⓐ</span>
      </button>
      <button type="button" class="theme-btn" data-theme-val="light" aria-label="Light theme" title="Light Mode">
        <span class="theme-icon">☀</span>
      </button>
      <button type="button" class="theme-btn" data-theme-val="dark" aria-label="Dark theme" title="Dark Mode">
        <span class="theme-icon">☾</span>
      </button>
    </div>
  </div>
  <div class="site-container">

    <header class="site-header">
      <div class="masthead">
        <div class="masthead-meta">
          <span class="masthead-location">Warboys, Cambridgeshire</span>
          <span class="masthead-tagline">The Independent Village Daily Briefing</span>
        </div>
        <div class="masthead-main">
          <a href="/" class="site-title">{{ village.villageName }} Daily</a>
        </div>
        <div class="site-subtitle">Daily local news, council governance & community briefing for {{ village.villageName }}, {{ village.county }}</div>
      </div>
      <nav class="site-nav">
        <a href="/">Today</a>
        <a href="/calendar/">Events Calendar</a>
        <a href="/wpa/">Primary Academy</a>
        <a href="/archive/">Archive</a>
      </nav>
    </header>

    <main class="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div>
        <strong>{{ village.siteTitle }}</strong> &bull; Aggregating Huntingdonshire District Council, Warboys Parish Council & local news feeds.
      </div>
      <div>
        Fork this project on <a href="https://github.com" target="_blank" rel="noopener">GitHub</a> to create a site for your village.
      </div>
    </footer>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const themeBtns = document.querySelectorAll('.theme-btn');
      if (!themeBtns.length) return;
      
      function getCurrentMode() {
        return localStorage.getItem('theme') || 'auto';
      }

      function applyTheme(mode) {
        if (mode === 'dark' || mode === 'light') {
          document.documentElement.setAttribute('data-theme', mode);
          localStorage.setItem('theme', mode);
        } else {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme', 'auto');
        }

        themeBtns.forEach(btn => {
          if (btn.getAttribute('data-theme-val') === mode) {
            btn.classList.add('active');
            btn.setAttribute('aria-checked', 'true');
          } else {
            btn.classList.remove('active');
            btn.setAttribute('aria-checked', 'false');
          }
        });
      }

      applyTheme(getCurrentMode());

      themeBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const mode = this.getAttribute('data-theme-val');
          applyTheme(mode);
        });
      });
    });
  </script>
</body>
</html>
