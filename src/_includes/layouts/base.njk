<!DOCTYPE html>
<html lang="en" data-place="{{ (village.placeName or village.villageName or 'warboys') | lower }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or village.siteTitle }}</title>
  <meta name="description" content="{{ description or village.siteDescription }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="canonical" href="{{ page.url }}">
  {% if village.theme %}
  <style>
    :root, html[data-theme="light"] {
      {% if village.theme.primary %}--color-primary: {{ village.theme.primary }};{% endif %}
      {% if village.theme.primaryHover %}--color-primary-hover: {{ village.theme.primaryHover }};{% endif %}
      {% if village.theme.accent %}--color-accent: {{ village.theme.accent }};{% endif %}
      {% if village.theme.tagBg %}--color-tag-bg: {{ village.theme.tagBg }};{% endif %}
      {% if village.theme.archiveBg %}--color-archive-bg: {{ village.theme.archiveBg }};{% endif %}
      {% if village.theme.archiveBorder %}--color-archive-border: {{ village.theme.archiveBorder }};{% endif %}
      {% if village.theme.archiveText %}--color-archive-text: {{ village.theme.archiveText }};{% endif %}
    }
    {% if village.theme.dark %}
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        {% if village.theme.dark.primary %}--color-primary: {{ village.theme.dark.primary }};{% endif %}
        {% if village.theme.dark.primaryHover %}--color-primary-hover: {{ village.theme.dark.primaryHover }};{% endif %}
        {% if village.theme.dark.accent %}--color-accent: {{ village.theme.dark.accent }};{% endif %}
        {% if village.theme.dark.tagBg %}--color-tag-bg: {{ village.theme.dark.tagBg }};{% endif %}
        {% if village.theme.dark.archiveBg %}--color-archive-bg: {{ village.theme.dark.archiveBg }};{% endif %}
        {% if village.theme.dark.archiveBorder %}--color-archive-border: {{ village.theme.dark.archiveBorder }};{% endif %}
        {% if village.theme.dark.archiveText %}--color-archive-text: {{ village.theme.dark.archiveText }};{% endif %}
      }
    }
    html[data-theme="dark"] {
      {% if village.theme.dark.primary %}--color-primary: {{ village.theme.dark.primary }};{% endif %}
      {% if village.theme.dark.primaryHover %}--color-primary-hover: {{ village.theme.dark.primaryHover }};{% endif %}
      {% if village.theme.dark.accent %}--color-accent: {{ village.theme.dark.accent }};{% endif %}
      {% if village.theme.dark.tagBg %}--color-tag-bg: {{ village.theme.dark.tagBg }};{% endif %}
      {% if village.theme.dark.archiveBg %}--color-archive-bg: {{ village.theme.dark.archiveBg }};{% endif %}
      {% if village.theme.dark.archiveBorder %}--color-archive-border: {{ village.theme.dark.archiveBorder }};{% endif %}
      {% if village.theme.dark.archiveText %}--color-archive-text: {{ village.theme.dark.archiveText }};{% endif %}
    }
    {% endif %}
  </style>
  {% endif %}
  <script>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    })();
  </script>
</head>
<body>
  <div class="ai-disclosure-banner">
    <div class="ai-disclosure-content">
      <span>⚡ Automated local briefing with AI-assisted summaries</span>
    </div>
    <button id="theme-toggle" class="theme-toggle-btn" aria-label="Theme mode" title="Theme: Auto (Browser Default)">
      <span class="theme-icon">Ⓐ</span>
    </button>
  </div>
  <div class="site-container">

    {% set latestBriefingItem = collections.briefings[0] %}
    {% set displayDate = date or (latestBriefing.data.date if latestBriefing else (latestBriefingItem.data.date if latestBriefingItem else null)) %}
    {% set targetIso = isoDate or (latestBriefing.data.isoDate if latestBriefing else (latestBriefingItem.data.isoDate if latestBriefingItem else null)) %}
    {% set briefingPermalink = ('/archive/' + targetIso + '/') if targetIso else '/' %}

    <header class="site-header site-header-broadsheet">
      <div class="masthead-broadsheet">
        <div class="masthead-brand">
          <a href="/" class="site-title">{{ village.villageName }} Daily Briefing</a>
          <div class="site-subtitle">Local news, council governance &amp; community updates for {{ village.villageName }}, {{ village.county }}</div>
        </div>
        <div class="masthead-right">
          <a href="{{ briefingPermalink }}" class="masthead-date-pill" title="Permalink for {{ displayDate | formatDate if displayDate else 'this briefing' }}">
            <span>{% if displayDate %}{{ displayDate | formatDate }}{% else %}Today{% endif %}</span>
            <span class="masthead-county-sep">&bull;</span>
            <span>{{ village.county }}</span>
          </a>
          <nav class="site-nav" aria-label="Primary navigation">
            <a href="/" {% if page.url == '/' %}class="is-active" aria-current="page"{% endif %}>Today</a>
            <a href="/calendar/" {% if page.url and page.url.startsWith('/calendar') %}class="is-active" aria-current="page"{% endif %}>Events Calendar</a>
            {% if village.schools and village.schools.length > 0 %}
              <a href="{{ village.schoolNavUrl }}" {% if page.url and (page.url.startsWith('/schools') or page.url.startsWith('/wpa') or page.url.startsWith('/abbey')) %}class="is-active" aria-current="page"{% endif %}>{{ village.schoolNavLabel }}</a>
            {% endif %}
            <a href="/archive/" {% if page.url and page.url.startsWith('/archive') %}class="is-active" aria-current="page"{% endif %}>Archive</a>
          </nav>
        </div>
      </div>
      <div class="masthead-double-rule" aria-hidden="true"></div>
    </header>

    <main class="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div>
        &copy; 2026 {{ village.villageName }} Daily. All cited articles, headlines, and content snippets remain the copyright of their respective original publishers and owners.
      </div>
    </footer>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const toggleBtn = document.getElementById('theme-toggle');
      if (!toggleBtn) return;

      const modes = ['auto', 'light', 'dark'];
      const icons = { auto: 'Ⓐ', light: '☀', dark: '☾' };
      const titles = { auto: 'Theme: Auto (Browser Default)', light: 'Theme: Light Mode', dark: 'Theme: Dark Mode' };

      function getCurrentMode() {
        const saved = localStorage.getItem('theme');
        return (saved === 'dark' || saved === 'light') ? saved : 'auto';
      }

      function applyTheme(mode) {
        if (mode === 'dark' || mode === 'light') {
          document.documentElement.setAttribute('data-theme', mode);
          localStorage.setItem('theme', mode);
        } else {
          document.documentElement.removeAttribute('data-theme');
          localStorage.removeItem('theme');
        }

        const iconEl = toggleBtn.querySelector('.theme-icon');
        if (iconEl) iconEl.textContent = icons[mode] || 'Ⓐ';
        toggleBtn.setAttribute('title', titles[mode] || 'Theme mode');
        toggleBtn.setAttribute('aria-label', titles[mode] || 'Theme mode');
      }

      let currentMode = getCurrentMode();
      applyTheme(currentMode);

      toggleBtn.addEventListener('click', function() {
        const currentIndex = modes.indexOf(currentMode);
        currentMode = modes[(currentIndex + 1) % modes.length];
        applyTheme(currentMode);
      });
    });
  </script>
</body>
</html>
