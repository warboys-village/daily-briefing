<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or village.siteTitle }}</title>
  <meta name="description" content="{{ description or village.siteDescription }}">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="{{ village.siteTitle }} RSS Feed" href="/feed.xml">
</head>
<body>
  <div class="site-container">
    <header class="site-header">
      <div class="header-top">
        <div>
          <a href="/" class="site-title">{{ village.villageName }} Daily</a>
          <div class="site-subtitle">Daily local news & council briefing for {{ village.villageName }}, {{ village.county }}</div>
        </div>
        <nav class="site-nav">
          <a href="/">Today</a>
          <a href="/calendar/">Events Calendar</a>
          <a href="/archive/">Archive</a>
          <a href="/feed.xml">RSS Feed</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div>
        <strong>{{ village.siteTitle }}</strong> &bull; Aggregating Huntingdonshire District Council, Warboys Parish Council & local news feeds.
      </div>
      <div>
        Fork this project on <a href="https://github.com" target="_blank" rel="noopener">GitHub</a> to create a site for your village.
      </div>
    </footer>
  </div>
</body>
</html>
