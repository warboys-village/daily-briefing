---
layout: layouts/base.njk
eleventyComputed:
  title: "{{ village.villageName }} Schools Overview & Briefings"
permalink: "/schools/index.html"
---

{% set latestBriefing = collections.briefings[0] %}

<header class="briefing-header">
  <div class="briefing-header-top">
    <a href="/index.html" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem; font-weight: 600; text-decoration: none;">&larr; Back to Main Briefing</a>
    <span class="briefing-date">{% if latestBriefing %}{{ latestBriefing.data.date | formatDate }}{% else %}Latest Briefing{% endif %}</span>
  </div>
  <h1 class="briefing-title">🎓 {{ village.villageName }} Schools</h1>
  <p class="briefing-subtitle">Weekly Newsletters, Dates for Your Diary, and iCalendar Subscriptions for local schools in {{ village.villageName }}</p>
</header>

{% if village.isMultiSchool %}
  <!-- Multi-School 2-Column Grid Layout -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.75rem; margin-top: 1.5rem;">
    {% for sc in village.schools %}
      <div class="school-card" style="background: var(--color-card-bg); border: 2px solid var(--color-border); border-radius: 8px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem;">
            <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.35rem; color: var(--color-primary); font-weight: 700;">
              {{ sc.name }}
            </h3>
            <span class="badge-status badge-today" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;">{{ sc.shortName }}</span>
          </div>

          <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 1.25rem;">
            Local school serving families in {{ village.villageName }}, {{ village.county }}.
          </p>

          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem;">
            {% for yg in sc.yearGroups %}
              <span class="badge-status badge-other" style="font-size: 0.75rem;">{{ yg.code }} ({{ yg.label }})</span>
            {% endfor %}
          </div>
        </div>

        <div style="border-top: 1px solid var(--color-border); padding-top: 1rem; margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.65rem;">
          <a href="/{{ sc.slug }}/" class="button-link" style="text-align: center; padding: 0.65rem 1rem; font-weight: 700; background: var(--color-primary); color: #ffffff;">
            View {{ sc.shortName }} Daily Briefing & Diary &rarr;
          </a>
          <div style="display: flex; gap: 0.5rem; justify-content: space-between;">
            {% if sc.officialUrl %}
              <a href="{{ sc.officialUrl }}" target="_blank" rel="noopener" style="font-size: 0.85rem; color: var(--color-primary); font-weight: 600; text-decoration: none;">Official Website &rarr;</a>
            {% endif %}
            {% if sc.newsletterUrl %}
              <a href="{{ sc.newsletterUrl }}" target="_blank" rel="noopener" style="font-size: 0.85rem; color: var(--color-primary); font-weight: 600; text-decoration: none;">Latest Newsletter &rarr;</a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <!-- Single School Row Layout -->
  {% set sc = village.schools[0] or village.school %}
  <div style="background: var(--color-tag-bg); border: 2px solid var(--color-primary); border-radius: 8px; padding: 1.5rem; margin-top: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
      <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.4rem; color: var(--color-primary); font-weight: 700;">
        🏫 {{ sc.name }}
      </h3>
      <span class="badge-status badge-today">{{ sc.shortName }}</span>
    </div>
    <p style="font-size: 1rem; color: var(--color-text-main); margin-bottom: 1.25rem;">
      The primary educational institution for {{ village.villageName }}, {{ village.county }}.
    </p>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/{{ sc.slug }}/" class="button-link" style="padding: 0.6rem 1.25rem; font-weight: 700; background: var(--color-primary); color: #ffffff;">
        Go to {{ sc.name }} Daily Briefing &rarr;
      </a>
      {% if sc.officialUrl %}
        <a href="{{ sc.officialUrl }}" target="_blank" rel="noopener" class="button-link" style="padding: 0.6rem 1rem; background: var(--color-tag-bg); color: var(--color-primary); border: 1px solid var(--color-border);">
          Official Website &rarr;
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}
