---
permalink: "/wpa.ics"
eleventyExcludeFromCollections: true
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Warboys Daily Briefing//WPA School Calendar//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Warboys Primary Academy Diary
X-WR-TIMEZONE:Europe/London
{% for item in wpa_calendar %}
BEGIN:VEVENT
UID:{{ item.id }}@village-daily
DTSTAMP:20260815T200000Z
DTSTART;VALUE=DATE:{{ item.eventDate | replace("-", "") }}
DTEND;VALUE=DATE:{{ item.eventDate | replace("-", "") }}
SUMMARY:{{ item.title | safe }}
DESCRIPTION:{{ item.notes | safe }}
LOCATION:{{ item.venue | safe }}
URL:{{ item.url }}
END:VEVENT
{% endfor %}
END:VCALENDAR
