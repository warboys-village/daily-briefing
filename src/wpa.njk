---
layout: layouts/base.njk
pagination:
  data: village.schools
  size: 1
  alias: currentSchool
eleventyComputed:
  title: "{{ currentSchool.name | default('School') }} Daily Briefing & Diary"
  permalink: "/{{ currentSchool.slug | default('wpa') }}/index.html"
---

{% set latestBriefing = collections.briefings[0] %}
{% set schoolName = currentSchool.name | default('School') %}
{% set schoolShort = currentSchool.shortName | default('School') %}
{% set schoolSlug = currentSchool.slug | default('wpa') %}
{% set officialUrl = currentSchool.officialUrl %}
{% set newsletterUrl = currentSchool.newsletterUrl %}
{% set parentForumUrl = currentSchool.parentForumPdfUrl %}
{% set yearList = currentSchool.yearGroups %}
{% set refDate = latestBriefing.data.date if latestBriefing else "2026-09-05" %}
{% set immediateDates = currentSchool.keyDates | filterKeyDatesImmediate(refDate, 35) %}
{% set futureDates = currentSchool.keyDates | filterKeyDatesFuture(refDate, 35) %}

<header class="briefing-header">
  <div class="briefing-header-top">
    {% if village.isMultiSchool %}
      <a href="/schools/index.html" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem; font-weight: 600; text-decoration: none;">&larr; All {{ village.placeName }} Schools</a>
    {% else %}
      <a href="/index.html" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem; font-weight: 600; text-decoration: none;">&larr; Back to Main Briefing</a>
    {% endif %}
    <span class="briefing-date">{% if latestBriefing %}{{ latestBriefing.data.date | formatDate }}{% else %}Latest Briefing{% endif %}</span>
  </div>
  <h1 class="briefing-title">🎓 {{ schoolName }} Daily Briefing</h1>
  <p class="briefing-subtitle">Weekly School Newsletter, Dates for Your Diary{% if parentForumUrl %}, & Parent Forum Minutes{% endif %}</p>
</header>

<div class="school-banner-box" style="background: var(--color-tag-bg); border: 2px solid var(--color-primary); padding: 1.25rem; border-radius: 8px; margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h3 style="margin: 0; font-family: var(--font-serif);">
        {% if officialUrl %}
          <a href="{{ officialUrl }}" target="_blank" rel="noopener" style="color: var(--color-primary); text-decoration: none; font-weight: 700;">🏫 {{ schoolName }} Official Website &rarr;</a>
        {% else %}
          <span style="color: var(--color-primary); font-weight: 700;">🏫 {{ schoolName }}</span>
        {% endif %}
      </h3>
      {% if currentSchool.description %}
        <p style="margin: 0.35rem 0 0 0; font-size: 0.88rem; color: var(--color-text-muted);">{{ currentSchool.description }}</p>
      {% endif %}
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      {% if newsletterUrl %}
        <a href="{{ newsletterUrl }}" target="_blank" rel="noopener" class="button-link" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">📰 Read Full Weekly Newsletter &rarr;</a>
      {% endif %}
      {% if parentForumUrl %}
        <a href="{{ parentForumUrl }}" target="_blank" rel="noopener" class="button-link" style="padding: 0.4rem 0.85rem; font-size: 0.85rem; background: var(--color-tag-bg); color: var(--color-primary); border: 1px solid var(--color-border);">📄 Parent Forum Minutes (PDF) &rarr;</a>
      {% endif %}
    </div>
  </div>
</div>

<!-- iCalendar Year Group Subscription Modal -->
<div id="school-ical-modal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.55); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
  <div class="modal-content" style="background: var(--color-card-bg); border-radius: 8px; max-width: 480px; width: 90%; padding: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.25); border: 1px solid var(--color-border); position: relative;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
      <h3 style="margin: 0; font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-primary);">📅 Subscribe to {{ schoolShort }} iCalendar</h3>
      <button type="button" id="btn-close-school-ical-modal" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--color-text-muted); line-height: 1;">&times;</button>
    </div>
    <p style="font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1.25rem;">
      Select your child's year group to subscribe in Apple Calendar, Google Calendar, or Microsoft Outlook:
    </p>
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      {% if yearList and yearList.length > 0 %}
        {% for yg in yearList %}
        <a href="/{{ schoolSlug }}-{{ yg.slug }}.ics" class="button-link" style="display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1rem; font-size: 0.9rem; text-decoration: none; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-tag-bg); color: var(--color-text-main);">
          <span><strong>{{ yg.label }}</strong></span>
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-primary);">Subscribe &rarr;</span>
        </a>
        {% endfor %}
      {% endif %}
      <a href="/{{ schoolSlug }}.ics" class="button-link" style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 1rem; font-size: 0.9rem; text-decoration: none; border: 1px solid var(--color-primary); border-radius: 6px; background: var(--color-primary); color: #ffffff; margin-top: 0.25rem;">
        <span><strong>All Years Combined</strong></span>
        <span style="font-size: 0.8rem; font-weight: 600; color: #ffffff;">Subscribe &rarr;</span>
      </a>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('school-ical-modal');
  const btnOpens = document.querySelectorAll('.btn-open-school-ical-modal');
  const btnClose = document.getElementById('btn-close-school-ical-modal');

  btnOpens.forEach(btn => {
    btn.addEventListener('click', () => {
      if (modal) modal.style.display = 'flex';
    });
  });

  if (btnClose && modal) {
    btnClose.addEventListener('click', () => {
      modal.style.display = 'none';
    });
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.style.display = 'none';
    });
  }
});
</script>

<!-- 1. DATES FOR YOUR DIARY SECTION -->
<div class="briefing-block" style="margin-bottom: 2.5rem;" id="school-diary-section">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Dates for Your Diary</h3>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      {% if currentSchool.announcements and currentSchool.announcements.length > 0 %}
        <a href="#school-news-section" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-main); text-decoration: none;">📰 Jump to News &darr;</a>
      {% endif %}
      <button type="button" class="btn-open-school-ical-modal button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">📅 Subscribe to calendar &rarr;</button>
    </div>
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">

    <p style="margin-bottom: 1.25rem; color: var(--color-text-muted); font-size: 0.9rem;">
      Official term dates and diary schedule for {{ schoolName }}. Targeted year groups indicated by pill badges.
    </p>

    <div class="diary-events-list">
      {% if immediateDates and immediateDates.length > 0 %}
        {% for evt in immediateDates %}
          <div class="news-card {% if evt.cancelled %}event-cancelled{% endif %}" style="border-left: 4px solid {% if evt.cancelled %}#ef4444{% else %}var(--color-primary){% endif %}; margin-bottom: 1rem; {% if evt.cancelled %}opacity: 0.78;{% endif %}">
            <div class="news-card-header" style="align-items: flex-start;">
              <div>
                <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.35rem; {% if evt.cancelled %}text-decoration: line-through; color: var(--color-text-muted);{% endif %}">
                  {% if evt.cancelled %}<span class="badge-status" style="background: #fee2e2; color: #dc2626; margin-right: 0.35rem; font-weight: 700;">CANCELLED</span>{% endif %}
                  {{ evt.title }}
                </h5>
                <span style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600;">📅 {{ evt.time or evt.date }}</span>
              </div>
              {% if evt.targetYears %}
                <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                  {% for yg in evt.targetYears %}
                    <span class="badge-status badge-year-{{ yg | lower | replace(' ', '-') }}" style="font-size: 0.75rem; padding: 0.15rem 0.45rem;">{{ yg }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
            <div class="news-summary" style="margin-bottom: 0;">
              <p>{{ evt.details or evt.notes }}</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}

      {% if futureDates and futureDates.length > 0 %}
        <details class="diary-more-container">
          <summary class="diary-more-summary">
            <span class="summary-expand-text">📅 Show remaining term &amp; future dates ({{ futureDates.length }} more) &darr;</span>
            <span class="summary-collapse-text">Show fewer dates &uarr;</span>
          </summary>
          <div class="diary-more-content" style="margin-top: 1rem;">
            {% for evt in futureDates %}
              <div class="news-card {% if evt.cancelled %}event-cancelled{% endif %}" style="border-left: 4px solid {% if evt.cancelled %}#ef4444{% else %}var(--color-primary){% endif %}; margin-bottom: 1rem; {% if evt.cancelled %}opacity: 0.78;{% endif %}">
                <div class="news-card-header" style="align-items: flex-start;">
                  <div>
                    <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.35rem; {% if evt.cancelled %}text-decoration: line-through; color: var(--color-text-muted);{% endif %}">
                      {% if evt.cancelled %}<span class="badge-status" style="background: #fee2e2; color: #dc2626; margin-right: 0.35rem; font-weight: 700;">CANCELLED</span>{% endif %}
                      {{ evt.title }}
                    </h5>
                    <span style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600;">📅 {{ evt.time or evt.date }}</span>
                  </div>
                  {% if evt.targetYears %}
                    <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                      {% for yg in evt.targetYears %}
                        <span class="badge-status badge-year-{{ yg | lower | replace(' ', '-') }}" style="font-size: 0.75rem; padding: 0.15rem 0.45rem;">{{ yg }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
                <div class="news-summary" style="margin-bottom: 0;">
                  <p>{{ evt.details or evt.notes }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </details>
      {% elif not immediateDates or immediateDates.length === 0 %}
        <p style="color: var(--color-text-muted); font-style: italic;">No specific diary dates recorded for this period.</p>
      {% endif %}
    </div>
  </div>
</div>

<!-- 2. NEWSLETTER ANNOUNCEMENTS -->
{% if currentSchool.announcements and currentSchool.announcements.length > 0 %}
<div class="briefing-block" id="school-news-section" style="margin-bottom: 2.5rem;">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Latest Announcements & Updates</h3>
    {% if newsletterUrl %}
      <a href="{{ newsletterUrl }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">📰 Read School Newsletter &rarr;</a>
    {% endif %}
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">
    {% for ann in currentSchool.announcements %}
      <div class="news-card" style="margin-bottom: 1rem;">
        <div class="news-card-header">
          <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700;">{{ ann.title }}</h5>
          {% if ann.date %}
            <span style="font-size: 0.8rem; color: var(--color-text-muted); font-weight: 600;">{{ ann.date }}</span>
          {% endif %}
        </div>
        <div class="news-summary" style="margin-bottom: 0;">
          <p>{{ ann.content }}</p>
          {% if ann.url %}
            <div style="margin-top: 0.5rem;">
              <a href="{{ ann.url }}" target="_blank" rel="noopener" style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary);">Read more &rarr;</a>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- 3. PARENT FORUM SECTION (ONLY IF AVAILABLE) -->
{% if parentForumUrl %}
<div class="briefing-block" style="margin-bottom: 2rem;">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Parent Forum Minutes & Key Actions</h3>
    <a href="{{ parentForumUrl }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">📄 Open Full Minutes (PDF) &rarr;</a>
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">
    <p style="margin-bottom: 1rem; color: var(--color-text-muted); font-size: 0.9rem;">
      Summary of discussions between school leadership, governors, and parent representatives.
    </p>

    <div class="news-card" style="border-left: 4px solid var(--color-primary); margin-bottom: 1rem;">
      <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.5rem;">Communication & School Platforms</h5>
      <div class="news-summary" style="margin-bottom: 0;">
        <p>Parent representatives highlighted the high utility of weekly digital newsletters and requested continued consolidation of school event schedules into digital calendar feeds.</p>
      </div>
    </div>
  </div>
</div>
{% endif %}
