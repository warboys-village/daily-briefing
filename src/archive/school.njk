---
layout: layouts/base.njk
pagination:
  data: archiveSchoolPages
  size: 1
  alias: pageData
permalink: "/archive/{{ pageData.isoDate }}/{{ pageData.slug }}/index.html"
eleventyComputed:
  title: "{{ pageData.schoolName }} Briefing & Diary ({{ pageData.formattedDate }})"
---

{% set currentSchool = pageData.school %}
{% set schoolName = currentSchool.name | default('School') %}
{% set schoolShort = currentSchool.shortName | default('School') %}
{% set schoolSlug = currentSchool.slug | default('wpa') %}
{% set officialUrl = currentSchool.officialUrl %}
{% set newsletterUrl = currentSchool.newsletterUrl %}
{% set parentForumUrl = currentSchool.parentForumPdfUrl %}
{% set yearList = currentSchool.yearGroups %}
{% set refDate = pageData.isoDate %}
{% set immediateDates = currentSchool.keyDates | filterKeyDatesImmediate(refDate, 35) %}
{% set futureDates = currentSchool.keyDates | filterKeyDatesFuture(refDate, 35) %}

<header class="briefing-header">
  <div class="archive-notice-bar">
    <span>Viewing an archive briefing page</span>
    <a href="/{{ schoolSlug }}/">Return to today's {{ schoolShort }} page &rarr;</a>
  </div>
  <h1 class="briefing-title">🎓 {{ schoolName }} Daily Briefing</h1>
  <p class="briefing-subtitle">Archive for {{ pageData.formattedDate }}</p>
</header>

<div class="school-banner-box" style="background: var(--color-tag-bg); border: 2px solid var(--color-primary); padding: 1.25rem; border-radius: 8px; margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h3 style="margin: 0; font-family: var(--font-serif);">
        {% if officialUrl %}
          <a href="{{ officialUrl }}" target="_blank" rel="noopener" style="color: var(--color-primary); text-decoration: none; font-weight: 700;">🏫 {{ schoolName }} Official Website &rarr;</a>
        {% else %}
          <span style="color: var(--color-primary); font-weight: 700;">🏫 {{ schoolName }}</span>
        {% endif %}
      </h3>
      {% if currentSchool.description %}
        <p style="margin: 0.35rem 0 0 0; font-size: 0.88rem; color: var(--color-text-muted);">{{ currentSchool.description }}</p>
      {% endif %}
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      {% if newsletterUrl %}
        <a href="{{ newsletterUrl }}" target="_blank" rel="noopener" class="button-link" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">📰 Read Full Weekly Newsletter &rarr;</a>
      {% endif %}
      {% if parentForumUrl %}
        <a href="{{ parentForumUrl }}" target="_blank" rel="noopener" class="button-link" style="padding: 0.4rem 0.85rem; font-size: 0.85rem; background: var(--color-tag-bg); color: var(--color-primary); border: 1px solid var(--color-border);">📄 Parent Forum Minutes (PDF) &rarr;</a>
      {% endif %}
    </div>
  </div>
</div>

<!-- 1. DATES FOR YOUR DIARY SECTION -->
<div class="briefing-block" style="margin-bottom: 2.5rem;" id="school-diary-section">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Dates for Your Diary</h3>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      {% if currentSchool.announcements and currentSchool.announcements.length > 0 %}
        <a href="#school-news-section" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-main); text-decoration: none;">📰 Jump to News &darr;</a>
      {% endif %}
      <a href="/archive/{{ pageData.isoDate }}/" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">&larr; Read Daily Briefing</a>
    </div>
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">
    <div class="diary-events-list">
      {% if immediateDates and immediateDates.length > 0 %}
        {% for evt in immediateDates %}
          <div class="news-card {% if evt.cancelled %}event-cancelled{% endif %}" style="border-left: 4px solid {% if evt.cancelled %}#ef4444{% else %}var(--color-primary){% endif %}; margin-bottom: 1rem; {% if evt.cancelled %}opacity: 0.78;{% endif %}">
            <div class="news-card-header" style="align-items: flex-start;">
              <div>
                <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.35rem; {% if evt.cancelled %}text-decoration: line-through; color: var(--color-text-muted);{% endif %}">
                  {% if evt.cancelled %}<span class="badge-status" style="background: #fee2e2; color: #dc2626; margin-right: 0.35rem; font-weight: 700;">CANCELLED</span>{% endif %}
                  {{ evt.title }}
                </h5>
                <span style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600;">📅 {{ evt.time or evt.date }}</span>
              </div>
              {% if evt.targetYears %}
                <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                  {% for yg in evt.targetYears %}
                    <span class="badge-status badge-year-{{ yg | lower | replace(' ', '-') }}" style="font-size: 0.75rem; padding: 0.15rem 0.45rem;">{{ yg }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
            <div class="news-summary" style="margin-bottom: 0;">
              <p>{{ evt.details or evt.notes }}</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}

      {% if futureDates and futureDates.length > 0 %}
        <details class="diary-more-container">
          <summary class="diary-more-summary">
            <span class="summary-expand-text">📅 Show remaining term &amp; future dates ({{ futureDates.length }} more) &darr;</span>
            <span class="summary-collapse-text">Show fewer dates &uarr;</span>
          </summary>
          <div class="diary-more-content" style="margin-top: 1rem;">
            {% for evt in futureDates %}
              <div class="news-card {% if evt.cancelled %}event-cancelled{% endif %}" style="border-left: 4px solid {% if evt.cancelled %}#ef4444{% else %}var(--color-primary){% endif %}; margin-bottom: 1rem; {% if evt.cancelled %}opacity: 0.78;{% endif %}">
                <div class="news-card-header" style="align-items: flex-start;">
                  <div>
                    <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.35rem; {% if evt.cancelled %}text-decoration: line-through; color: var(--color-text-muted);{% endif %}">
                      {% if evt.cancelled %}<span class="badge-status" style="background: #fee2e2; color: #dc2626; margin-right: 0.35rem; font-weight: 700;">CANCELLED</span>{% endif %}
                      {{ evt.title }}
                    </h5>
                    <span style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600;">📅 {{ evt.time or evt.date }}</span>
                  </div>
                  {% if evt.targetYears %}
                    <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                      {% for yg in evt.targetYears %}
                        <span class="badge-status badge-year-{{ yg | lower | replace(' ', '-') }}" style="font-size: 0.75rem; padding: 0.15rem 0.45rem;">{{ yg }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
                <div class="news-summary" style="margin-bottom: 0;">
                  <p>{{ evt.details or evt.notes }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </details>
      {% elif not immediateDates or immediateDates.length === 0 %}
        <p style="color: var(--color-text-muted); font-style: italic;">No specific diary dates recorded for this date.</p>
      {% endif %}
    </div>
  </div>
</div>

<!-- 2. NEWSLETTER ANNOUNCEMENTS -->
{% if currentSchool.announcements and currentSchool.announcements.length > 0 %}
<div class="briefing-block" id="school-news-section" style="margin-bottom: 2.5rem;">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Announcements & Updates</h3>
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">
    {% for ann in currentSchool.announcements %}
      <div class="news-card" style="margin-bottom: 1rem;">
        <div class="news-card-header">
          <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700;">{{ ann.title }}</h5>
          {% if ann.date %}
            <span style="font-size: 0.8rem; color: var(--color-text-muted); font-weight: 600;">{{ ann.date }}</span>
          {% endif %}
        </div>
        <div class="news-summary" style="margin-bottom: 0;">
          <p>{{ ann.content }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- 3. PARENT FORUM SECTION (ONLY IF AVAILABLE) -->
{% if parentForumUrl %}
<div class="briefing-block" style="margin-bottom: 2rem;">
  <div class="briefing-block-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <h3 class="briefing-block-title" style="margin-bottom: 0;">Parent Forum Minutes & Key Actions</h3>
    <a href="{{ parentForumUrl }}" target="_blank" rel="noopener" class="button-link" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;">📄 Open Full Minutes (PDF) &rarr;</a>
  </div>
  <div class="briefing-block-content" style="padding-top: 1.25rem;">
    <div class="news-card" style="border-left: 4px solid var(--color-primary); margin-bottom: 1rem;">
      <h5 class="news-title" style="color: var(--color-text-main); font-weight: 700; margin-bottom: 0.5rem;">Communication & School Platforms</h5>
      <div class="news-summary" style="margin-bottom: 0;">
        <p>Parent representatives highlighted the high utility of weekly digital newsletters and requested continued consolidation of school event schedules into digital calendar feeds.</p>
      </div>
    </div>
  </div>
</div>
{% endif %}

<nav class="archive-actions" style="margin-top: 1.5rem;">
  <a href="/archive/{{ pageData.isoDate }}/" class="button-link">&larr; Back to {{ pageData.formattedDate }} Briefing</a>
  <a href="/archive/" class="button-link">Archive Index</a>
</nav>
